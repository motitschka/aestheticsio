rules_version = '2';

// Who can do what (the aesthetics themselves ship with the app):
// - the owner (adminEmail) manages the allowlist
// - allowlisted accounts can read everyone's leaderboard profile, and
//   read/write only their own progress and profile
// - everyone else is denied everything (guests never touch the database)
service cloud.firestore {
  match /databases/{database}/documents {

    // Set with: npm run set-admin -- you@gmail.com
    function adminEmail() {
      return 'REPLACE_WITH_YOUR_GOOGLE_EMAIL';
    }

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    function isAdmin() {
      return signedIn() && email() == adminEmail().lower();
    }

    function isAllowed() {
      let allowlist = /databases/$(database)/documents/config/allowlist;
      return isAdmin()
        || (signedIn() && exists(allowlist) && email() in get(allowlist).data.emails);
    }

    function isSelf(uid) {
      return isAllowed() && request.auth.uid == uid;
    }

    // A challenge sprint of n answers takes at least n × 0.8 s.
    function optionalTime(d, key, n) {
      return !(key in d) || (d[key] is int && d[key] >= n * 800);
    }

    function optionalCount(d, key, max) {
      return !(key in d) || (d[key] is int && d[key] >= 0 && d[key] <= max);
    }

    // Learned lessons per era (eight eras; the biggest has fewer than 60 aesthetics).
    function validEras(d) {
      return !('eras' in d) || (d.eras is list && d.eras.size() == 8
        && d.eras[0] is int && d.eras[1] is int && d.eras[2] is int && d.eras[3] is int
        && d.eras[4] is int && d.eras[5] is int && d.eras[6] is int && d.eras[7] is int
        && d.eras[0] >= 0 && d.eras[1] >= 0 && d.eras[2] >= 0 && d.eras[3] >= 0
        && d.eras[4] >= 0 && d.eras[5] >= 0 && d.eras[6] >= 0 && d.eras[7] >= 0
        && d.eras[0] <= 60 && d.eras[1] <= 60 && d.eras[2] <= 60 && d.eras[3] <= 60
        && d.eras[4] <= 60 && d.eras[5] <= 60 && d.eras[6] <= 60 && d.eras[7] <= 60);
    }

    function validProfile(d) {
      return d.keys().hasOnly(['nickname', 'avatar', 'lessonPoints', 'bestStreak', 'best25', 'best50', 'best100', 'correct', 'answered', 'updatedAt',
          'eras', 'dayStreak', 'goalDay', 'freezes', 'recent'])
        && d.keys().hasAll(['nickname', 'avatar', 'lessonPoints', 'bestStreak', 'correct', 'answered'])
        && d.nickname is string && d.nickname.size() >= 1 && d.nickname.size() <= 24
        && d.avatar is string && d.avatar.size() <= 100
        // 174 aesthetics; learned counts 1, mastered 2
        && d.lessonPoints is int && d.lessonPoints >= 0 && d.lessonPoints <= 400
        && d.bestStreak is int && d.bestStreak >= 0 && d.bestStreak <= 10000
        && optionalTime(d, 'best25', 25) && optionalTime(d, 'best50', 50) && optionalTime(d, 'best100', 100)
        && d.correct is int && d.answered is int
        && d.correct >= 0 && d.correct <= d.answered
        // the journey through time: era progress, the day streak and moments for the circle feed
        && validEras(d)
        && optionalCount(d, 'dayStreak', 100000)
        && optionalCount(d, 'freezes', 2)
        && (!('goalDay' in d) || (d.goalDay is string && d.goalDay.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')))
        && (!('recent' in d) || (d.recent is list && d.recent.size() <= 6));
    }

    match /config/allowlist {
      allow read, write: if isAdmin();
    }

    match /progress/{uid} {
      allow read, write: if isSelf(uid);
    }

    match /profiles/{uid} {
      allow read: if isAllowed();
      allow create, update: if isSelf(uid) && validProfile(request.resource.data);
      allow delete: if isSelf(uid);
    }
  }
}
