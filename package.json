{
  "name": "aesthetic-learner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:demo": "vite --host --mode demo",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "lint": "oxlint",
    "test": "vitest run",
    "fetch-data": "node scripts/fetch-aesthetics.mjs",
    "set-admin": "node scripts/set-admin.mjs",
    "emulators": "firebase emulators:start --only auth,firestore",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "test:rules": "firebase emulators:exec --only firestore --project demo-aesthetics \"vitest run --config vitest.rules.config.ts\"",
    "make-themes": "node scripts/make-themes.mjs",
    "make-pins": "node scripts/make-pins.mjs",
    "make-icon": "node scripts/make-icon.cjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.32.0",
    "oxlint": "^1.81.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
