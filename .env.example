# Copy to .env.local and fill in from Firebase console →
# Project settings → General → Your apps → Web app → SDK setup and configuration.
# These identify your project; they are not secrets (the Firestore rules protect the data).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Set to true to use the local Firebase emulators (npm run emulators, needs Java)
VITE_USE_EMULATORS=false
