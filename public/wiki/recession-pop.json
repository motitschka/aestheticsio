w":160,"h":120,"v":"https://aesthetics.fandom.com/wiki/File:Jada_-_American_Cowboy"},{"src":"https://static.wikia.nocookie.net/aesthetics/images/1/1f/Disney.png/revision/latest?cb=20230325143128","w":160,"h":146},{"src":"https://static.wikia.nocookie.net/aesthetics/images/8/81/Dancecrew.png/revision/latest?cb=20230325143212","w":160,"h":243},{"src":"https://static.wikia.nocookie.net/aesthetics/images/f/fb/Taylor.jpg/revision/latest?cb=20230328003137","w":160,"h":240,"cap":["Taylor Swift in ElectroPop 08 aesthetic"]},{"src":"https://static.wikia.nocookie.net/aesthetics/images/d/d5/Robynbodytalk.jpg/revision/latest?cb=20240406195615","w":160,"h":160,"cap":["Robyn - Body Talk (2010)"]},{"src":"https://static.wikia.nocookie.net/aesthetics/images/f/f9/Jedward_-_Waterline.jpg/revision/latest?cb=20250610045142","w":213,"h":120,"cap":["Jedward - Waterline (2012)"]},{"src":"https://static.wikia.nocookie.net/aesthetics/images/b/b9/DEV_-_Bass_Down_Low_%28Explicit%29_ft._The_Cataracs_%28Official_Music_Video%29/revision/latest?cb=20250714001500","w":160,"h":120,"v":"https://aesthetics.fandom.com/wiki/File:DEV_-_Bass_Down_Low_(Explicit)_ft._The_Cataracs_(Official_Music_Video)"}]}]}]}